# One configuration file is used both locally and on the VPS.
# Public IPv4 address of the VPS. The public hostname becomes <PUBLIC_IP>.sslip.io.
PUBLIC_IP=REPLACE_WITH_PUBLIC_IPV4
ACME_EMAIL=REPLACE_WITH_EMAIL

# Required only by task prod:up:no-infra. Example: infra_default
INFRA_NETWORK=

# Generate a long random value. It becomes part of the private calendar URL.
CALENDAR_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

ITMO_USERNAME=REPLACE_WITH_ITMO_LOGIN
ITMO_PASSWORD=REPLACE_WITH_ITMO_PASSWORD
CACHE_TTL_SECONDS=900

# Leave both values empty to disable Telegram notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional for direct local runs; production Compose overrides it with the Xray proxy.
TELEGRAM_PROXY_URL=
TELEGRAM_SILENT=false

RUST_LOG=info
