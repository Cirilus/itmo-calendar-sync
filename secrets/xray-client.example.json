{
  "log": {
    "loglevel": "warning",
    "access": "none"
  },
  "inbounds": [
    {
      "tag": "telegram-http-proxy",
      "listen": "0.0.0.0",
      "port": 1080,
      "protocol": "http",
      "settings": {}
    }
  ],
  "outbounds": [
    {
      "tag": "reality-out",
      "protocol": "vless",
      "settings": {
        "address": "REPLACE_WITH_REMOTE_SERVER",
        "port": 443,
        "id": "REPLACE_WITH_UUID",
        "encryption": "none",
        "flow": "xtls-rprx-vision",
        "level": 0
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "fingerprint": "chrome",
          "serverName": "REPLACE_WITH_SNI",
          "password": "REPLACE_WITH_REALITY_PASSWORD",
          "shortId": "REPLACE_WITH_EVEN_LENGTH_HEX_SHORT_ID",
          "spiderX": "/"
        }
      }
    }
  ]
}
